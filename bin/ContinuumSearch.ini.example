[ContinuumSearchService]
    ;; Optional private event subscription API. Distinct from WebUIWriteSecret.
    ;; Configure the same dedicated key in simulator [Search] and Robust [LoginService].
    EventNotificationSecret =
    ;; XML-RPC endpoint used by [Search] SearchURL in every simulator.
    Port = 8010
    ;; Optional private resident-event writes from ContinuumWebUI. Keep this
    ;; endpoint on a trusted network or HTTPS. Never expose this secret to HTML.
    ;; Match [ContinuumWebUI] SearchWriteSecret; distinct from crawler/economy keys.
    ; WebUIWriteSecret = ""
    ;; Optional paid classified publication. URL must use HTTPS, except loopback
    ;; HTTP for services on this host. Match the economy WebUIClassifiedSecret;
    ;; this is separate from the portal/crawler/region secrets. Disabled when blank.
    ; ClassifiedEconomyURL = "http://127.0.0.1:8009"
    ; ClassifiedEconomySecret = ""
    MinimumClassifiedPrice = 50
    ClassifiedEconomyTimeoutMilliseconds = 5000

    ;; DataSnapshot regions register here through [DataSnapshot] data_services.
    RegistrationPath = "/search/register"
    SnapshotBatchSize = 10
    SnapshotIntervalSeconds = 600
    ConnectTimeoutSeconds = 10
    RequestTimeoutSeconds = 30

    ;; Leave false for an Internet-facing service. Set true only when region
    ;; DataSnapshot endpoints intentionally use RFC1918/private grid addresses.
    AllowPrivateSnapshotHosts = false

[Database]
    ;; Supported: SQLite, MySQL, PostgreSQL.
    StorageProvider = "SQLite"
    ;; Use the profile database so the authoritative classifieds table is
    ;; searchable too. This is the official SQLite standalone default.
    ConnectionString = "Data Source=userprofiles.db;Version=3;"

    ;; MySQL example (use the same database that contains profile classifieds):
    ; StorageProvider = "MySQL"
    ; ConnectionString = "Data Source=127.0.0.1;Database=opensim;User ID=opensim;Password=CHANGE_ME;Old Guids=true;"

    ;; PostgreSQL example:
    ; StorageProvider = "PostgreSQL"
    ; ConnectionString = "Server=127.0.0.1;Database=opensim;User Id=opensim;Password=CHANGE_ME;"
