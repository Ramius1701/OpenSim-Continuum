:VERSION 3 # -----------------

BEGIN;

CREATE TABLE IF NOT EXISTS `experiences` (
	`public_id` VARCHAR(36) NOT NULL,
	`owner_id` VARCHAR(36) NOT NULL,
	`name` VARCHAR(42) NOT NULL,
	`description` VARCHAR(128) NOT NULL,
	`group_id` VARCHAR(36) NOT NULL,
	`logo` VARCHAR(36) NOT NULL,
	`marketplace` VARCHAR(256) NOT NULL,
	`slurl` VARCHAR(256) NOT NULL,
	`maturity` INT NOT NULL,
	`properties` INT NOT NULL,
	PRIMARY KEY (`public_id`) USING BTREE
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_unicode_ci;

CREATE TABLE IF NOT EXISTS `experience_permissions` (
	`experience` VARCHAR(36) NOT NULL COLLATE 'utf8_unicode_ci',
	`avatar` VARCHAR(36) NOT NULL COLLATE 'utf8_unicode_ci',
	`allow` BIT(1) NOT NULL,
	PRIMARY KEY (`experience`, `avatar`) USING BTREE,
	INDEX `avatar` (`avatar`) USING BTREE
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_unicode_ci;

COMMIT;

:VERSION 4 # -----------------

BEGIN;

CREATE TABLE IF NOT EXISTS `experience_kv` (
	`experience` VARCHAR(36) NOT NULL,
	`key` VARCHAR(1011) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
    `value` VARCHAR(4095) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL,
    PRIMARY KEY(`experience`, `key`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8;

COMMIT;

:VERSION 5 # -----------------

BEGIN;

ALTER TABLE `experiences`
    ADD INDEX `experiences_owner` (`owner_id`),
    ADD INDEX `experiences_group` (`group_id`);

COMMIT;

:VERSION 6 # -----------------

BEGIN;

ALTER TABLE `experiences`
    CONVERT TO CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

COMMIT;

:VERSION 7 # -----------------

BEGIN;

ALTER TABLE `experience_kv`
    ADD COLUMN `key_hash` BINARY(32) NULL AFTER `experience`,
    DROP PRIMARY KEY;

ALTER TABLE `experience_kv`
    MODIFY COLUMN `key` VARCHAR(1011)
        CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL;

UPDATE `experience_kv`
    SET `key_hash` = UNHEX(SHA2(`key`, 256));

ALTER TABLE `experience_kv`
    MODIFY COLUMN `key_hash` BINARY(32) NOT NULL,
    ADD PRIMARY KEY (`experience`, `key_hash`);

COMMIT;
