# -----------------
:VERSION 1

BEGIN;

CREATE TABLE `AbuseReports` (
  `ReportID` int(11) NOT NULL AUTO_INCREMENT,
  `SenderID` char(36) COLLATE utf8_unicode_ci NOT NULL,
  `SenderName` varchar(64) COLLATE utf8_unicode_ci DEFAULT NULL,
  `Time` int(11) DEFAULT NULL,
  `AbuseRegionID` varchar(36) COLLATE utf8_unicode_ci DEFAULT NULL,
  `AbuseRegionName` varchar(45) COLLATE utf8_unicode_ci DEFAULT NULL,
  `AbuserID` char(36) COLLATE utf8_unicode_ci NOT NULL,
  `AbuserName` varchar(128) CHARACTER SET utf8mb4 DEFAULT NULL,
  `Category` int(11) DEFAULT NULL,
  `CheckFlags` int(11) DEFAULT NULL,
  `Details` varchar(1280) CHARACTER SET utf8mb4 DEFAULT NULL,
  `ObjectID` varchar(36) COLLATE utf8_unicode_ci DEFAULT NULL,
  `Position` varchar(45) COLLATE utf8_unicode_ci DEFAULT NULL,
  `ReportType` varchar(45) COLLATE utf8_unicode_ci DEFAULT NULL,
  `Summary` varchar(4608) CHARACTER SET utf8mb4 DEFAULT NULL,
  `Version` varchar(256) CHARACTER SET utf8 DEFAULT NULL,
  `ImageData` longblob,
  PRIMARY KEY (`ReportID`)
) ENGINE=MyISAM DEFAULT CHARSET=utf8 COLLATE=utf8_unicode_ci;

COMMIT;

# -----------------
:VERSION 2

BEGIN;

ALTER TABLE `AbuseReports`
  MODIFY `Category` varchar(128) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  MODIFY `ReportType` int(11) DEFAULT NULL,
  ENGINE=InnoDB,
  CONVERT TO CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

COMMIT;

# -----------------
:VERSION 3

BEGIN;

ALTER TABLE `AbuseReports`
  ADD COLUMN `Status` varchar(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'Open',
  ADD COLUMN `ModeratorNotes` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
  ADD COLUMN `ModeratorID` char(36) CHARACTER SET ascii COLLATE ascii_general_ci NOT NULL DEFAULT '00000000-0000-0000-0000-000000000000',
  ADD COLUMN `ModeratorName` varchar(128) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  ADD COLUMN `LastUpdated` int(11) NOT NULL DEFAULT 0,
  ADD INDEX `StatusTime` (`Status`, `Time`),
  ADD INDEX `AbuserIDIndex` (`AbuserID`),
  ADD INDEX `AbuseRegionIDIndex` (`AbuseRegionID`);

UPDATE `AbuseReports` SET `LastUpdated` = `Time` WHERE `LastUpdated` = 0;

COMMIT;

# -----------------
:VERSION 4

BEGIN;

# Match the service's bounded 64 KiB details contract and the unbounded text
# providers used by SQLite/PostgreSQL. Existing reports are preserved.
ALTER TABLE `AbuseReports`
  MODIFY `Details` mediumtext CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
  MODIFY `Summary` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

COMMIT;
