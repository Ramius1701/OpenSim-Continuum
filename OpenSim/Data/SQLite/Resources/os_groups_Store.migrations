:VERSION 1

BEGIN;
CREATE TABLE os_groups_groups (GroupID TEXT PRIMARY KEY, Location TEXT NOT NULL DEFAULT '', Name TEXT NOT NULL UNIQUE, Charter TEXT NOT NULL DEFAULT '', InsigniaID TEXT NOT NULL DEFAULT '', FounderID TEXT NOT NULL DEFAULT '', MembershipFee INTEGER NOT NULL DEFAULT 0, OpenEnrollment INTEGER NOT NULL DEFAULT 0, ShowInList INTEGER NOT NULL DEFAULT 0, AllowPublish INTEGER NOT NULL DEFAULT 0, MaturePublish INTEGER NOT NULL DEFAULT 0, OwnerRoleID TEXT NOT NULL DEFAULT '');
CREATE TABLE os_groups_membership (GroupID TEXT NOT NULL, PrincipalID TEXT NOT NULL, SelectedRoleID TEXT NOT NULL DEFAULT '', Contribution INTEGER NOT NULL DEFAULT 0, ListInProfile INTEGER NOT NULL DEFAULT 1, AcceptNotices INTEGER NOT NULL DEFAULT 1, AccessToken TEXT NOT NULL DEFAULT '', PRIMARY KEY(GroupID,PrincipalID));
CREATE INDEX os_groups_membership_principal ON os_groups_membership(PrincipalID);
CREATE TABLE os_groups_roles (GroupID TEXT NOT NULL, RoleID TEXT NOT NULL, Name TEXT NOT NULL DEFAULT '', Description TEXT NOT NULL DEFAULT '', Title TEXT NOT NULL DEFAULT '', Powers INTEGER NOT NULL DEFAULT 0, PRIMARY KEY(GroupID,RoleID));
CREATE TABLE os_groups_rolemembership (GroupID TEXT NOT NULL, RoleID TEXT NOT NULL, PrincipalID TEXT NOT NULL, PRIMARY KEY(GroupID,RoleID,PrincipalID));
CREATE INDEX os_groups_rolemembership_principal ON os_groups_rolemembership(PrincipalID);
CREATE TABLE os_groups_invites (InviteID TEXT PRIMARY KEY, GroupID TEXT NOT NULL, RoleID TEXT NOT NULL, PrincipalID TEXT NOT NULL, TMStamp TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP, UNIQUE(GroupID,PrincipalID));
CREATE TABLE os_groups_notices (GroupID TEXT NOT NULL, NoticeID TEXT PRIMARY KEY, TMStamp INTEGER NOT NULL DEFAULT 0, FromName TEXT NOT NULL DEFAULT '', Subject TEXT NOT NULL DEFAULT '', Message TEXT NOT NULL DEFAULT '', HasAttachment INTEGER NOT NULL DEFAULT 0, AttachmentType INTEGER NOT NULL DEFAULT 0, AttachmentName TEXT NOT NULL DEFAULT '', AttachmentItemID TEXT NOT NULL DEFAULT '00000000-0000-0000-0000-000000000000', AttachmentOwnerID TEXT NOT NULL DEFAULT '');
CREATE INDEX os_groups_notices_group ON os_groups_notices(GroupID);
CREATE TABLE os_groups_principals (PrincipalID TEXT PRIMARY KEY, ActiveGroupID TEXT NOT NULL DEFAULT '00000000-0000-0000-0000-000000000000');
CREATE TABLE os_groups_bans (GroupID TEXT NOT NULL, PrincipalID TEXT NOT NULL, BanTime INTEGER NOT NULL DEFAULT 0, PRIMARY KEY(GroupID,PrincipalID));
COMMIT;
