<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <ItemGroup>
    <Reference Include="OpenSim.Framework"><HintPath>../../bin/OpenSim.Framework.dll</HintPath></Reference>
    <Reference Include="OpenMetaverseTypes"><HintPath>../../bin/OpenMetaverseTypes.dll</HintPath></Reference>
    <Reference Include="OpenSim.Continuum.Economy"><HintPath>../../bin/OpenSim.Continuum.Economy.dll</HintPath></Reference>
    <Reference Include="System.Data.SQLite"><HintPath>../../bin/System.Data.SQLite.dll</HintPath></Reference>
    <Content Include="../../bin/*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <Content Include="../../bin/lib64/*sqlite*" CopyToOutputDirectory="PreserveNewest" Link="lib64/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
