; Weather module - ported from GuntharDeNiro/opensim, cleaned up as a
; standalone addon-module (no core patches needed).
;
; This file is picked up automatically via the addon-modules Include-modules
; glob in OpenSimDefaults.ini. Copy/rename to Weather.ini (or edit in place)
; and adjust as needed; nothing here takes effect until Enabled = true.

[Weather]
    ; Master switch. Off by default - this is a genuine opt-in addon,
    ; unlike the source project's original "showroom" build where a second
    ; AllowDisabled flag silently overrode Enabled = false.
    Enabled = false

    ; In-world chat command channel estate managers (or anyone, if
    ; EstateManagerOnly = false) can use to control weather:
    ; /89 clear | sunny | rain | storm | snow
    CommandChannel = 89
    EstateManagerOnly = true

    ; Weather particle coverage and strength.
    EmitterGrid = 8
    EmitterHeight = 18
    Intensity = 1.0
    AvoidCoveredAreas = true
    CoverProbeHeight = 96

    ; Darker clouds and wind are applied while weather is active, then
    ; restored when it clears.
    AdjustClouds = true
    RestoreCloudsOnClear = true
    AdjustWind = true
    RestoreWindOnClear = true
    WindDirectionDegrees = 70
    WindDirectionVarianceDegrees = 18
    RainWindStrength = 0.45
    StormWindStrength = 1.35
    SnowWindStrength = 0.22

    ; Storm effects.
    LightningEnabled = true
    LightningMinDelayMS = 7000
    LightningMaxDelayMS = 18000
    ThunderEnabled = true
    ThunderSound =
    ThunderVolume = 1.0

    ; Automatically pick a random weather preset after region startup and
    ; every N hours. AutoCycleChoices accepts: storm, rain, snow, sunny, clear.
    AutoCycleEnabled = true
    AutoCycleHours = 6
    AutoCycleStartupDelaySeconds = 30
    AutoCycleChangeOnStartup = true
    AutoCycleChoices = storm,rain,snow,sunny,clear
    AutoCycleForecastWarningMinutes = 15

    ; Sends a one-time IM to arriving avatars describing current weather.
    SendWeatherIMOnEntry = true
    WeatherIMDelaySeconds = 5
    WeatherIMMessage =
