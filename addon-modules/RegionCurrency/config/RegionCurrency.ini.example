; RegionCurrency - avatar wallet + PayPal token purchases, ported from
; GuntharDeNiro/opensim's RegionWeb module (the Currency/PayPal system there
; originally shared a login with the Estate Admin control room; it's been
; split out here into its own independent module with its own login, at the
; user's request, since the two features have nothing to do with each
; other and sharing auth code between them was the main obstacle to
; separating them cleanly).
;
; This is real, functioning PayPal integration code (OAuth2 client-
; credentials flow against PayPal's actual REST API), not a stub - but it
; moves real money. Review it carefully, test in PayPalEnvironment=sandbox
; first, and understand the requires-a-browser-return caveat below before
; using this in production.
;
; Requires an IMoneyModule (e.g. BetaGridLikeMoneyModule) to actually credit
; balances - this module is a web front-end for whatever money module you
; already have configured, not a currency backend itself.
;
; Picked up automatically via the addon-modules Include-modules glob in
; OpenSimDefaults.ini.

[RegionCurrency]
    ; Master switch. Off by default.
    Enabled = false

    ; Public HTTP path this module serves on. Independent of RegionWeb's
    ; own PublicPath - they no longer share a path or a login.
    PublicPath = /currency

    ; Estate title shown in page titles/nav (same value you'd set in
    ; RegionWeb's own config, if you're running both).
    EstateTitle = My OpenSim Estate

    CurrencyBuyEnabled = true
    CurrencyTransferEnabled = true

    ; Login token settings (avatar requests a one-time code via in-world
    ; IM, then enters it here).
    CurrencyChallengeMinutes = 10
    CurrencyChallengeCooldownSeconds = 20
    CurrencySessionHours = 12

    CurrencyStatementLimit = 30
    CurrencyBuyLimit = 100000

    ; grant: instantly credits the buyer (only meaningful if PayPal is off
    ;   and you trust the local buy button, e.g. no real money involved).
    ; request: creates a pending request an estate admin must approve.
    ; paypal: routes purchases through PayPal Checkout (see below).
    CurrencyBuyMode = grant
    CurrencyPurchaseStorage = Currency/regioncurrency-purchases.tsv

    ; --- PayPal (only used when CurrencyBuyMode = paypal) ---
    ; This makes real outbound HTTP calls to PayPal's REST API using these
    ; credentials. Get sandbox credentials from developer.paypal.com before
    ; ever setting PayPalEnvironment = live.
    PayPalEnabled = false
    PayPalEnvironment = sandbox
    PayPalClientID =
    PayPalClientSecret =
    PayPalCurrencyCode = EUR
    PayPalPricePerToken = 0.01
    ; Must be a public HTTPS URL PayPal can redirect the buyer's browser
    ; back to after checkout - see the caveat above about what happens if
    ; the buyer closes their browser before that redirect completes.
    PayPalReturnBaseUrl =
    PayPalOrderStorage = Currency/regioncurrency-paypal-orders.tsv
