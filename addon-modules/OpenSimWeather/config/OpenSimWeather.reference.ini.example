    Ambient = 0.14,0.15,0.17,1.0
    SunMoonColor = 0.20,0.21,0.24,1.0
    SunMoonPosition = 0.317
    EastAngle = 0.0
    MaxAltitude = 1605
    HazeHorizon = 0.40
    HazeDensity = 0.82
    DensityMultiplier = 0.28
    DistanceMultiplier = 0.90
    SunGlowFocus = 0.08
    SunGlowSize = 1.40
    SceneGamma = 0.78
    StarBrightness = 0.03
    DrawClassicClouds = true
    CloudScrollXLock = false
    CloudScrollYLock = false

