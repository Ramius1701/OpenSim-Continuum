;; OpenSimWeather 0.3.4 manual production test
;; Viewer-ready assets for these stable UUIDs ship in bin/assets.

[Weather]
    Enabled = false
    CommandChannel = 89
    EstateManagerOnly = true

    CoverageMode = Region
    EmitterGrid = 8
    EmitterHeight = 18.0
    Intensity = 1.0

    RainTexture = 8b3abcad-4d33-420e-b1be-a598a9defe66
    StormTexture = 474c95d8-b6c0-41ed-ab92-d823587a279a
    SnowTexture = 64eb249a-956e-4ab5-a780-26f5845d01f0
    LightningTexture = b7a57ead-1093-478d-b79d-b3e80dcae357

    AvoidCoveredAreas = true
    CoverProbeGrid = 3
    MinimumOpenSkyFraction = 0.67
    SuppressAroundCoveredAvatars = true
    UseExclusionVolumes = true
    ExclusionObjectName = Weather Exclusion

    AdjustEnvironment = false
    AdjustWind = false
    SurfaceEffectsEnabled = false

    LightningEnabled = true
    ThunderEnabled = false
    ThunderSound = bf51f599-920b-4ceb-94a2-531032d6a610
    AutoCycleEnabled = false
    SendWeatherIMOnEntry = false
