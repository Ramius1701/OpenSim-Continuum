;; OpenSimWeather 0.3.4 environment/wind example
;;
;; OpenSim persists region environment changes. Export or record the current
;; region environment before enabling this example. All four configurable
;; weather profiles are included below and may be edited per weather type.
;; SunMoonPosition and EastAngle are LightShare fractions of a full circle
;; from 0.0 through 1.0. MaxAltitude is the LightShare atmosphere altitude.

[Weather]
    Enabled = false
    CommandChannel = 89
    EstateManagerOnly = true

    CoverageMode = Region
    EmitterGrid = 8

    RainTexture =
    StormTexture =
    SnowTexture =
    LightningTexture =

    AvoidCoveredAreas = true
    CoverProbeGrid = 3
    MinimumOpenSkyFraction = 0.67
    UseExclusionVolumes = true
    ExclusionObjectName = Weather Exclusion

    AdjustEnvironment = true
    AllowPersistentEnvironmentChanges = true
    RestoreCloudsOnClear = true

    AdjustWind = true
    RestoreWindOnClear = true
    WindDirectionDegrees = 70.0
    WindDirectionVarianceDegrees = 18.0
    RainWindStrength = 0.45
    StormWindStrength = 1.35
    SnowWindStrength = 0.22

    SurfaceEffectsEnabled = false
    LightningEnabled = true
    ThunderEnabled = false
    AutoCycleEnabled = false

[Weather.Environment.Sunny]
    CloudCoverage = 0.05
    CloudScale = 0.28
    CloudColor = 1.0,0.98,0.9,1.0
    CloudXYDensity = 0.38,0.18,0.28
    CloudDetailXYDensity = 0.34,0.16,0.04
    CloudScrollX = 0.06
    CloudScrollY = 0.012
    Horizon = 0.58,0.72,0.95,1.0
    BlueDensity = 0.16,0.32,0.68,1.0
    Ambient = 0.48,0.48,0.42,1.0
    SunMoonColor = 1.0,0.88,0.52,1.0
    SunMoonPosition = 0.317
    EastAngle = 0.0
    MaxAltitude = 1605
    HazeHorizon = 0.10
    HazeDensity = 0.18
    DensityMultiplier = 0.08
    DistanceMultiplier = 1.15
    SunGlowFocus = 0.22
    SunGlowSize = 2.40
    SceneGamma = 1.16
    StarBrightness = 0.00
    DrawClassicClouds = true
    CloudScrollXLock = false
    CloudScrollYLock = false

[Weather.Environment.Rain]
    CloudCoverage = 0.82
    CloudScale = 0.64
    CloudColor = 0.16,0.18,0.22,1.0
    CloudXYDensity = 1.18,0.60,0.96
    CloudDetailXYDensity = 1.32,0.64,0.24
    CloudScrollX = 0.28
    CloudScrollY = 0.05
    Horizon = 0.15,0.17,0.20,1.0
    BlueDensity = 0.07,0.09,0.13,1.0
    Ambient = 0.14,0.15,0.17,1.0
    SunMoonColor = 0.20,0.21,0.24,1.0
    SunMoonPosition = 0.317
    EastAngle = 0.0
    MaxAltitude = 1605
    HazeHorizon = 0.40
    HazeDensity = 0.82
    DensityMultiplier = 0.28
    DistanceMultiplier = 0.90
    SunGlowFocus = 0.08
    SunGlowSize = 1.40
    SceneGamma = 0.78
    StarBrightness = 0.03
    DrawClassicClouds = true
    CloudScrollXLock = false
    CloudScrollYLock = false

