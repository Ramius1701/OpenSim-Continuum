;; OpenSimWeather 0.3.4 experimental puddle/snow example
;;
;; Viewer-ready assets for these stable UUIDs ship in bin/assets.
;; Surface patches are temporary terrain overlays near active avatars. They do
;; not alter terrain textures and do not accumulate on roofs or mesh floors.

[Weather]
    Enabled = false
    CommandChannel = 89
    EstateManagerOnly = true

    CoverageMode = Region
    EmitterGrid = 8

    RainTexture = 8b3abcad-4d33-420e-b1be-a598a9defe66
    StormTexture = 474c95d8-b6c0-41ed-ab92-d823587a279a
    SnowTexture = 64eb249a-956e-4ab5-a780-26f5845d01f0
    LightningTexture = b7a57ead-1093-478d-b79d-b3e80dcae357

    AvoidCoveredAreas = true
    CoverProbeGrid = 3
    MinimumOpenSkyFraction = 0.67
    UseExclusionVolumes = true
    ExclusionObjectName = Weather Exclusion

    AdjustEnvironment = false
    AdjustWind = false

    SurfaceEffectsEnabled = true
    PuddlesEnabled = true
    SnowAccumulationEnabled = true
    PuddleTexture = 14a1d7fd-c48a-4d42-af42-4f0d67a1ee52
    SnowSurfaceTexture = b50a3526-58f5-4d4c-aad1-53fa7b0cca4f

    TemperatureC = -2.0
    FreezingPointC = 0.0

    RainWetnessPerHour = 0.35
    StormWetnessPerHour = 0.75
    SnowAccumulationPerHour = 0.30
    ClearDryingPerHour = 0.08
    SunnyDryingPerHour = 0.25
    ClearSnowMeltPerHour = 0.05
    SunnySnowMeltPerHour = 0.22
    RainSnowMeltPerHour = 0.45

    PuddleStartLevel = 0.12
    SnowPatchStartLevel = 0.08
    SurfacePatchSpacingMeters = 20.0
    SurfaceRadiusMeters = 80.0
    MaxSurfacePatches = 128
    MaxSurfaceSlopeDegrees = 8.0
    PuddleLowPointToleranceMeters = 0.08
    SurfaceUpdateSeconds = 60

    LightningEnabled = true
    ThunderEnabled = false
    ThunderSound = bf51f599-920b-4ceb-94a2-531032d6a610
    AutoCycleEnabled = false
