[MoneyServer]
; Viewer currency purchases must be enabled explicitly.
CurrencyOnOff = on

; Maximum successful viewer currency purchases in UTC calendar periods.
; A value of 0 disables that individual period limit.
TotalDay = 100
TotalWeek = 250
TotalMonth = 500

; A viewer purchase that would exceed this balance is rejected.
; Existing balances are not reduced by the purchase/quote path.
CurrencyMaximum = 10000

; --- AddBankerMoney admin endpoint ---
; This XML-RPC call grants currency directly and does NOT go through
; TotalDay/TotalWeek/TotalMonth/CurrencyMaximum. Set BankerAvatar to a
; trusted account's UUID.
BankerAvatar = 00000000-0000-0000-0000-000000000000

; Avatar UUIDs are not secret (discoverable via in-world profile lookups),
; so BankerAvatar alone is not sufficient access control for an endpoint
; that can mint unlimited, uncapped currency. Restrict which caller IPs
; may reach this endpoint at all. Defaults to localhost-only if unset.
; Only widen this to specific, trusted addresses (e.g. your Robust/region
; server IPs) - never to 0.0.0.0/open internet.
BankerAllowedIPs = 127.0.0.1,::1
